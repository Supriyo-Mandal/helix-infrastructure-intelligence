{
  "name": "HELIX Development Environment",

  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "GO_VERSION": "1.25.0",
      "PYTHON_VERSION": "3.12"
    }
  },

  "workspaceFolder": "/workspace/helix",

  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/helix,type=bind",

  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "redhat.vscode-yaml"
      ]
    }
  },

  "remoteUser": "vscode"
}